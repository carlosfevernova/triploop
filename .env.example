# TripLoop — Environment variables
#
# Rename to .env.local for local dev, or set each in Vercel Dashboard
# → Project Settings → Environment Variables for production.
#
# Categories:
#   1. Core infrastructure (required)
#   2. AI providers (at least 1 required — recommend OpenRouter free tier)
#   3. Maps + POI enrichment (required for /api/places/*, /api/routes/*)
#   4. Payments (required for /api/stripe/*)
#   5. Email + WhatsApp (optional per feature)
#   6. Admin + cron (required for /admin, /api/cron/*)
#   7. Affiliates (optional revenue enrichment)

# ─── 1. Core infrastructure ──────────────────────────────────────────────
# Supabase — auto-provisioned when using Vercel + Supabase integration.
# Otherwise create at supabase.com/dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbG... # anon/publishable key (safe to expose)
SUPABASE_SECRET_KEY=eyJhbG... # service_role key (SERVER ONLY, bypass RLS)

# Public app URL — used in email templates + OG canonical URLs
NEXT_PUBLIC_APP_URL=https://triploop.app

# ─── 2. AI providers (fallback chain — at least 1 required) ──────────────
# Priority order in src/app/api/ai/generate-trip/route.ts:
#   OpenRouter → Cloudflare → Fireworks → Groq → Anthropic
# OpenRouter free tier is generous; start there.

OPENROUTER_API_KEY=sk-or-v1-... # https://openrouter.ai/keys — FREE tier: 200 req/day
ANTHROPIC_API_KEY=sk-ant-... # https://console.anthropic.com/keys
GROQ_API_KEY=gsk_... # https://console.groq.com/keys — FREE
FIREWORKS_API_KEY=fw_... # https://fireworks.ai/api-keys
CLOUDFLARE_ACCOUNT_ID=xxxxx # https://dash.cloudflare.com — Workers AI
CLOUDFLARE_AI_TOKEN=xxxxx

# ─── 3. Maps + POI enrichment ────────────────────────────────────────────
# Google Maps: Places (New) + Routes v2 + Geocoding
# Enable at https://console.cloud.google.com → APIs & Services
GOOGLE_MAPS_API_KEY=AIza... # server-side — used by /api/places/* and /api/routes/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza... # client-side — used by MapLibre for base tiles

# OpenChargeMap — EV chargers for /api/places/ev-chargers
# FREE: https://openchargemap.org/site/develop
OPENCHARGEMAP_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional POI data enrichment (used by seed scripts, not runtime)
FOURSQUARE_API_KEY=
OPENTRIPMAP_API_KEY=
YELP_FUSION_API_KEY=

# ─── 4. Payments (Stripe) ────────────────────────────────────────────────
# Required for /api/stripe/checkout, /api/stripe/portal, /api/stripe/webhook
# Create at https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_live_... # or sk_test_ for dev
STRIPE_WEBHOOK_SECRET=whsec_... # from Stripe Dashboard → Developers → Webhooks (endpoint /api/stripe/webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... # or pk_test_ for dev

# Price IDs from Stripe Dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_...

# ─── 5. Email + WhatsApp ─────────────────────────────────────────────────
# Resend — waitlist welcome + trial-ending + weekly-digest emails
# https://resend.com/api-keys — FREE 3000/mo
RESEND_API_KEY=re_...
EMAIL_FROM=hello@triploop.app # verified sender in Resend
EMAIL_REPLY_TO=hello@triploop.app
WAITLIST_FROM_EMAIL=noreply@triploop.app # legacy alias, same domain

# Twilio WhatsApp Business API — for /api/whatsapp/webhook (optional, feature-flagged)
# https://console.twilio.com — requires WhatsApp Business Account approval
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886 # sandbox or approved sender
NEXT_PUBLIC_WHATSAPP_NUMBER=+521XXXXXXXXXX # for wa.me/ links on landing

# ─── 6. Admin + cron ─────────────────────────────────────────────────────
# Admin dashboard passphrase (HMAC-signed cookie, 24h TTL)
# Generate: openssl rand -hex 32
ADMIN_PASSPHRASE=change-me-32-chars-min

# Cron endpoint auth (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-random-hex

# Admin seed endpoints (POST /api/admin/seed-templates, /api/admin/seed-blog)
# Generate: openssl rand -hex 32
SEED_TOKEN=change-me-random-hex

# ─── 7. Affiliates (optional revenue enrichment) ─────────────────────────
# GetYourGuide — tours + activities affiliate
# https://partner.getyourguide.com
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=

# Booking.com — hotels affiliate
# https://join.booking.com
NEXT_PUBLIC_BOOKING_AID=

# ─── 8. Runtime metadata (auto-set by Vercel — do NOT set manually) ──────
# VERCEL_GIT_COMMIT_SHA — auto
# VERCEL_REGION — auto (iad1, sfo1, etc.)
# VERCEL_ENV — auto (production, preview, development)
# VERCEL_URL — auto (per-deployment URL)
